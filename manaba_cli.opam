# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "CLI client for University of Tsukuba manaba"
description: "Operate University of Tsukuba manaba from a terminal."
license: "GPL-3.0-only"
homepage: "https://github.com/Kyure-A/manaba-cli"
bug-reports: "https://github.com/Kyure-A/manaba-cli/issues"
depends: [
  "dune" {>= "3.12"}
  "ocaml" {>= "5.1"}
  "cmdliner"
  "cohttp-lwt-unix"
  "lambdasoup"
  "yojson"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/Kyure-A/manaba-cli.git"
